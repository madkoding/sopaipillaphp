# Application
APP_ENV=development
APP_NAME="SopaipillaPHP App"
RANDOM_SEED=change-this-to-a-long-random-secret

# Database driver: sqlite | mysql
DB_CONNECTION=sqlite

# SQLite (used when DB_CONNECTION=sqlite)
DB_DATABASE=:memory:

# MySQL (used when DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sopaipilla
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
