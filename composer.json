{
    "name": "sopaipilla/framework",
    "type": "framework",
    "description": "SopaipillaPHP - Lightweight PHP Framework",
    "keywords": [
        "php",
        "framework",
        "api",
        "orm"
    ],
    "homepage": "https://github.com/madkoding/sopaipilla-php",
    "license": "MIT",
    "authors": [
        {
            "name": "madKoding",
            "email": "madKoding@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Sopaipilla\\": "Sopaipilla/",
            "App\\": "App/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}