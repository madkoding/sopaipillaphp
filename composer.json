{
    "name": "sopaipilla/framework",
    "type": "framework",
    "description": "SopaipillaPHP - Lightweight PHP Framework",
    "keywords": [
        "php",
        "framework",
        "api",
        "orm"
    ],
    "homepage": "https://github.com/madkoding/sopaipillaphp",
    "license": "MIT",
    "authors": [
        {
            "name": "madKoding",
            "email": "madKoding@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Sopaipilla\\": "Sopaipilla/",
            "App\\": "App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 index.php",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-clover build/coverage/clover.xml",
        "stan": "phpstan analyse --no-progress",
        "cs:check": "php-cs-fixer check --diff --no-interaction",
        "cs:fix": "php-cs-fixer fix --no-interaction"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}